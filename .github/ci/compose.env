APP_ENV=ci
APP_SECRET_KEY=ci-placeholder-only
DATABASE_RUNTIME_URL=mssql+pyodbc://runtime:ci-placeholder-only@database:1433/openlibrary?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
DATABASE_MIGRATION_URL=mssql+pyodbc://migrator:ci-placeholder-only@database:1433/openlibrary?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
DATABASE_BOOTSTRAP_URL=mssql+pyodbc://sa:ci-placeholder-only@database:1433/master?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
REDIS_URL=redis://redis:6379/0
JWT_ISSUER=https://identity.openlibraryos.example
JWT_AUDIENCE=openlibraryos-api
JWT_SIGNING_KEY_ID=ci-placeholder-key
JWT_PRIVATE_KEY_PEM=ci-placeholder-private-key
JWT_PUBLIC_KEYS_JSON={"ci-placeholder-key":"ci-placeholder-public-key"}
JWT_ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
MSSQL_SA_PASSWORD=ci-placeholder-only
