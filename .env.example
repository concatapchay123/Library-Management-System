# OpenLibraryOS Environment Variables Template (Docker / Local Development)
# Copy this file to .env or .env.docker and adjust values with strong, locally generated secrets.
# DO NOT COMMIT ACTUAL PRODUCTION OR SENSITIVE SECRETS TO SOURCE CONTROL.

APP_ENV=development
APP_SECRET_KEY=replace-with-a-random-32-byte-secret-key-for-local-testing

# Database credentials & URLs (Internal Docker Network)
# Generate a strong password with at least 8 characters including uppercase, lowercase, digits and symbols.
MSSQL_SA_PASSWORD=ReplaceWithStrongPassword123!
DATABASE_BOOTSTRAP_URL=mssql+pyodbc://sa:ReplaceWithStrongPassword123!@database:1433/master?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
DATABASE_MIGRATION_URL=mssql+pyodbc://openlibrary_migrator:ReplaceWithStrongPassword123!@database:1433/openlibrary?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
DATABASE_RUNTIME_URL=mssql+pyodbc://openlibrary_runtime:ReplaceWithStrongPassword123!@database:1433/openlibrary?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes

# Redis URL
REDIS_URL=redis://redis:6379/0

# JWT Auth Configuration
# Generate RSA keypair with:
#   openssl genpkey -algorithm RSA -out private_key.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -pubout -in private_key.pem -out public_key.pem
# Replace newlines with \n when inlining into single-line environment variable format.
JWT_ISSUER=https://identity.openlibraryos.local
JWT_AUDIENCE=openlibraryos-api
JWT_SIGNING_KEY_ID=dev-local-jwt-key
JWT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n<REPLACE_WITH_RSA_PRIVATE_KEY_PEM>\n-----END PRIVATE KEY-----\n"
JWT_PUBLIC_KEYS_JSON='{"dev-local-jwt-key": "-----BEGIN PUBLIC KEY-----\n<REPLACE_WITH_RSA_PUBLIC_KEY_PEM>\n-----END PUBLIC KEY-----\n"}'
JWT_ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# Edge port configuration
HTTP_PORT=80
HTTPS_PORT=443

# Automatic Compose Profiles
COMPOSE_PROFILES=migration
